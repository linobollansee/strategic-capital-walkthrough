<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>{% block title %}Strategic Capital Walkthrough{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
    <script type="module" src="{{ asset('assets/app.js') }}" defer></script>
</head>
<body>
    <div class="page-shell">
        <header class="topbar">
            <div>
                <p class="eyebrow">Financial investments</p>
                <h1>Strategic Capital Walkthrough</h1>
            </div>
            <nav aria-label="Primary">
                <a href="#framework">Framework</a>
                <a href="#allocation">Allocation</a>
                <a href="#execution">Execution</a>
            </nav>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="footer">
            <p>Built with Symfony 8.0.11, PHP 8.5.6, HTML 5.2, CSS3, ES2025 JavaScript, and MySQL 9.7 LTS.</p>
        </footer>
    </div>
</body>
</html>
